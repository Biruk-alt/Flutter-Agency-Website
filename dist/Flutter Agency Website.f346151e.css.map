*, :before, :after {
  box-sizing: border-box;
}

:root {
  --dark-color: #1a1423;
  --light-color: #fdfffc;
  --accent-color: #7161ef;
}

html {
  scroll-behavior: smooth;
}

body {
  color: var(--dark-color);
  margin: 0;
  font-family: inter;
  font-weight: normal;
}

section {
  padding: 50px;
}

h2 {
  color: #0000;
  letter-spacing: -1px;
  background: linear-gradient(90deg, #312972 20%, #1a1423 60%) text;
  font-size: 36px;
  font-weight: 800;
  line-height: 130%;
}

h3 {
  letter-spacing: -1px;
  font-size: 24px;
  line-height: 130%;
}

a {
  color: var(--dark-color);
  text-decoration: none;
}

#btn {
  background-color: var(--accent-color);
  color: #fff;
  padding: 8px 26px;
  transition: all .3s;
}

#btn:hover {
  background: #5947de;
}

nav {
  background: rgba(white, white, white, .8);
  backdrop-filter: blur(10px);
  --webkit-backdrop-filter: blur(10px);
  z-index: 10;
  justify-content: space-between;
  align-items: center;
  max-width: 1200px;
  margin-bottom: 50px;
  padding: 16px 32px;
  font-weight: normal;
  display: flex;
  position: fixed;
  left: 0;
  right: 0;
  box-shadow: 0 8px 42px #0000001a;
}

#list {
  align-items: center;
  gap: 40px;
  display: flex;
}

#list a:hover {
  color: var(--accent-color);
}

#list #btn:hover {
  color: var(--light-color);
}

#logo {
  font-size: 18px;
  font-weight: normal;
}

#hero {
  flex: wrap;
  align-items: center;
  width: 100%;
  height: auto;
  min-height: 100vh;
  max-height: 800px;
  padding: 50px;
  display: flex;
  position: relative;
}

.menu-icon {
  cursor: pointer;
  padding: 8px;
  display: none;
}

.left, .right {
  flex: 100%;
  max-width: 100%;
}

h1 {
  font-size: 50px;
  font-weight: 800px;
  letter-spacing: -1px;
  color: #0000;
  background: linear-gradient(90deg, #312972 20%, #1a1423 60%) text;
  margin: 0;
  line-height: 100%;
}

.left {
  flex-direction: column;
  gap: 5px;
  max-width: 50%;
  display: flex;
}

p {
  margin-bottom: 50px;
  font-size: 16px;
  line-height: 160%;
}

.buttons a {
  background-color: var(--accent-color);
  border: 2px solid var(--accent-color);
  gap: 50px;
  margin-top: 24px;
  padding: 8px 28px;
}

#nobg {
  background-color: var(--light-color);
  margin-left: 20px;
}

#nobg:hover, .hasbg {
  background-color: var(--accent-color);
  color: var(--light-color);
}

.hasbg:hover {
  background: #5947de;
}

#hero .right img {
  object-fit: cover;
  z-index: 1;
  height: 600px;
}

.bg-color {
  filter: blur(110px);
  z-index: -1;
  background-color: #ad95ff;
  border-radius: 50%;
  width: 400px;
  height: 400px;
  position: absolute;
  right: 0;
}

.logos img {
  object-fit: contain;
  width: auto;
  height: 32px;
}

.logos {
  justify-content: center;
  align-items: center;
  gap: 40px;
  display: flex;
}

.feature {
  background-color: var(--light-color);
  z-index: -1px;
  border-radius: 30px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin: 0 50px;
  padding: 30px;
  display: flex;
  position: relative;
  box-shadow: 0 8px 42px #0000001a;
}

.feature h2 {
  color: #0000;
  background: linear-gradient(90deg, #312972 20%, #1a1423 60%) text;
  font-size: 36px;
}

#about {
  z-index: -2px;
  background-color: #f5f5f5;
  justify-content: center;
  align-items: center;
  margin-top: -93px;
  padding: 150px 30px 150px 150px;
  display: flex;
}

.about-img {
  object-fit: cover;
  width: 350px;
  height: 350px;
}

.left2 {
  flex-direction: column;
  align-items: center;
  max-width: 50%;
  display: flex;
}

.features {
  flex: 1;
  gap: 40px;
  display: flex;
}

p {
  font-size: 15px;
}

#nbg {
  background-color: var(--light-color);
  border: 2px solid var(--accent-color);
  color: var(--accent-color);
  gap: 50px;
  margin-top: 24px;
  margin-left: 20px;
  padding: 8px 28px;
}

#nbg:hover {
  background-color: var(--accent-color);
  color: var(--light-color);
}

#about {
  flex: 1;
  gap: 100px;
  display: flex;
}

.right2 {
  justify-content: center;
  align-self: start;
  align-items: center;
  max-width: 50%;
  padding-top: 100px;
  display: flex;
}

.right2 img {
  object-fit: cover;
  width: auto;
  height: 400px;
}

#services {
  background-color: #f5f5f5;
  flex-direction: column;
  align-items: center;
  margin-bottom: -90px;
  display: flex;
}

.services-box {
  flex-wrap: wrap;
  gap: 40px;
  width: 100%;
  max-width: 1200px;
  display: flex;
}

.intro {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 0;
  max-width: 500px;
  margin-inline: auto;
  display: flex;
}

.service {
  text-align: left;
  flex: 300px;
  overflow: hidden;
}

.service img {
  object-fit: cover;
  width: 100%;
  margin: 0;
}

.content {
  background-color: var(--light-color);
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 1px;
  margin: 0;
  transition: all .3s;
  display: flex;
}

.content:hover {
  background-color: var(--dark-color);
}

.content p, .content h3 {
  color: var(--dark-color) !important;
}

.content:hover p, .content:hover h3 {
  transform: scale(1.1);
  color: var(--light-color) !important;
}

.content p {
  max-width: 90%;
  text-align: center !important;
}

#why {
  background-color: var(--accent-color);
  min-height: 100vh;
  color: var(--light-color);
  flex: 1;
  align-items: center;
  gap: 100px;
  margin-top: 100px;
  display: flex;
}

#why img {
  object-fit: cover;
  width: auto;
  height: 400px;
}

.custom img, .expertise img {
  width: 26px !important;
  height: 26px !important;
}

.box {
  flex: 1;
  gap: 40px;
  display: flex;
}

.right3 {
  width: 50%;
}

#nnbg {
  background-color: var(--light-color);
  color: var(--dark-color);
  border: 2px solid var(--light-color);
  padding: 8px 28px;
}

#nnbg:hover {
  background-color: var(--accent-color);
  color: var(--light-color);
}

#why h2 {
  color: var(--light-color);
}

.box img {
  filter: brightness(0) invert();
}

#blog {
  background-color: #f5f5f5;
}

.big-box {
  flex-wrap: wrap;
  justify-content: center;
  gap: 30px;
  margin-bottom: 50px;
  display: flex;
}

.small-box {
  background: #fff;
  border-radius: 20px;
  flex: 300px;
  transition: all .4s;
  overflow: hidden;
  box-shadow: 0 4px 16px #0000001a;
}

.big-box img {
  object-fit: cover;
  width: 100%;
  display: block;
}

.box-content {
  padding: 20px;
  transition: all .4s;
}

.btnn {
  background-color: var(--accent-color);
  color: var(--light-color);
  border: none;
  border-radius: 5px;
  padding: 3px 5px;
}

.small-box:hover {
  transform: scale(1.05);
  box-shadow: 0 4px 16px #0000001a;

  & .box-content {
    background-color: var(--dark-color);
    color: var(--light-color);
  }
}

#post {
  border: 2px solid var(--accent-color);
  color: var(--accent-color);
  padding: 8px 28px;
  transition: all .3s;
}

#post:hover {
  background-color: var(--accent-color);
  color: var(--light-color);
}

.small-box h3 {
  margin: 0 0 5px;
}

#contact {
  background-color: #f5f5f5;
}

.header {
  text-align: center;
}

form {
  flex-direction: column;
  gap: 16px;
  display: flex;
}

form input, textarea {
  border: none;
  width: 100%;
  padding: 12px 25px;
  font-family: inter;
}

form input:focus, textarea:focus {
  border: 2px solid var(--accent-color);
  outline: none;
}

.group {
  gap: 28px;
  display: flex;
}

textarea {
  resize: none;
  height: 100px;
}

#send {
  background-color: var(--accent-color);
  width: 148px;
  height: 39px;
  color: var(--light-color);
  border: none;
  font-family: inter;
}

#send:hover {
  background-color: #5947de;
}

footer {
  background-color: var(--dark-color);
  color: var(--light-color);
  justify-content: space-between;
  padding: 30px 60px;
  display: flex;
}

footer p, h4 {
  color: var(--light-color);
  font-size: 14px;
  font-weight: -200;
}

footer #logo {
  color: var(--light-color);
}

.social {
  gap: 10px;
  display: flex;
}

.right4 {
  text-align: center;
}

.social img:hover {
  transform: scale(1.2);
}

.social img {
  transition: all .3s;
}

.lower {
  color: #ffffff4c;
  font-size: 14px;
}

footer p {
  margin-bottom: 8px;
}

footer a {
  margin: 0;
}

#mobile-list {
  background: var(--dark-color);
  z-index: 500;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 20px;
  width: 30%;
  height: 100%;
  transition: all .3s;
  display: none;
  position: fixed;
  transform: translateX(100%);
}

#mobile-list a {
  color: var(--light-color);
}

.mobile-close-icon {
  filter: brightness(0) invert();
  position: fixed;
  top: 18px;
  right: 32px;
}

#mobile-list.active {
  transform: translateX(0);
}

.overlay {
  backdrop-filter: blur(5px);
  z-index: 500;
  background: #0003;
  width: 100%;
  height: 100vh;
  display: none;
  position: fixed;
  top: 0;
  left: 0;
}

@media (width <= 1200px) {
  .about-img {
    width: 250px;
    height: 250px;
  }

  #nbg {
    margin: 0;
  }
}

@media (width <= 1005px) {
  h1 {
    font-size: 38px;
  }

  #hero img {
    width: 400px;
  }

  #about {
    flex-direction: column;
    display: flex;
  }

  .left2 {
    max-width: 100%;
  }

  .right2 {
    justify-content: center;
    align-items: center;
    max-width: 100%;
    display: flex;
  }

  #why {
    flex-direction: column;
    gap: 25px;
    display: flex;
  }

  .right3 {
    width: 100%;
    height: auto;
  }

  #why img {
    margin: 0;
  }
}

@media (width <= 767px) {
  h1 {
    font-size: 46px;
  }

  p {
    font-size: 18px;
    line-height: 130%;
  }

  h2 {
    font-size: 32px;
  }

  h3 {
    font-size: 18px;
  }

  #hero {
    flex-direction: column-reverse;
    justify-content: center;
    align-items: center;
    gap: 20px;
    max-height: fit-content;
    padding-top: 80px;
    display: flex;
  }

  #hero .right img {
    border-radius: 0 0 30% 30%;
    width: 300px;
    height: auto;
  }

  #list {
    display: none;
  }

  nav {
    max-width: 700px;
  }

  .menu-icon {
    cursor: pointer;
    padding: 8px;
    display: block;
  }

  #hero .left {
    justify-content: center;
    max-width: 100%;
    display: flex;
  }

  #hero .right {
    justify-content: center;
    width: 100%;
    display: flex;
  }

  .buttons {
    justify-content: center;
    align-items: center;
    display: flex;
  }

  #hero .left {
    text-align: center;
    justify-content: center;
    align-items: center;
    display: flex;
  }

  #about {
    flex-direction: column;
    display: flex;
  }

  .left2 {
    max-width: 100%;
  }

  .right2 {
    justify-content: center;
    align-items: center;
    max-width: 100%;
    display: flex;
  }

  #why {
    flex-direction: column;
    gap: 50px;
    min-height: 100vh;
    display: flex;
  }

  .right3 {
    width: 100%;
    height: auto;
  }

  #why img {
    margin: 0;
  }

  .group {
    flex-direction: column;
    gap: 14px;
    display: flex;
  }

  #mobile-list {
    background: var(--dark-color);
    z-index: 500;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px;
    width: 50%;
    height: 100vh;
    transition: all .3s;
    display: flex;
    position: fixed;
    transform: translateX(-100%);
  }

  #mobile-list a {
    color: var(--light-color);
  }

  .mobile-close-icon {
    filter: brightness(0) invert();
    position: fixed;
    top: 18px;
    right: 32px;
  }

  #mobile-list.active {
    transform: translateX(0);
  }

  #about {
    gap: 50px;
    padding-top: 100px;
    padding-left: 30px;
    padding-right: 30px;
    display: flex;
  }

  .right2 img {
    width: 350px;
    height: 350px;
  }

  .right2 {
    align-self: center;
    padding: 0;
  }

  .logos img {
    height: 20px;
  }
}
